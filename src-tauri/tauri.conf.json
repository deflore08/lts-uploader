{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LTS Replay Uploader",
  "mainBinaryName": "lts-uploader",
  "version": "0.6.0",
  "identifier": "ru.liandri.lts-uploader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LIANDRI Replay Uploader",
        "width": 435,
        "height": 659,
        "resizable": false,
        "maximizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#07060e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
